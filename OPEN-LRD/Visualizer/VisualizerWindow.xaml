<Window x:Class="OPEN_LRD.Visualizer.VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OPEN-LRD Visualizer"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#0E1117"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,8"
                Background="#171C27"
                BorderBrush="#2E3644"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Margin="0,0,18,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#E6EDF7"
                               Text="3D Visualizer" />
                    <Button x:Name="RefreshButton"
                            Margin="0,0,8,0"
                            Padding="12,4"
                            Click="Refresh_Button_Click"
                            Content="Refresh Graph"
                            ToolTip="Take a new snapshot of the core graph and rebuild the scene." />
                    <Button x:Name="RecomputeButton"
                            Margin="0,0,8,0"
                            Padding="12,4"
                            Click="Recompute_Button_Click"
                            Content="Recompute Layout"
                            ToolTip="Rerun the distance layout for the current snapshot." />
                    <Button x:Name="FrameAllButton"
                            Margin="0,0,8,0"
                            Padding="12,4"
                            Click="FrameAll_Button_Click"
                            Content="Frame All"
                            ToolTip="Frame the whole graph." />
                    <Button x:Name="ResetViewButton"
                            Padding="12,4"
                            Click="ResetView_Button_Click"
                            Content="Reset View"
                            ToolTip="Return to the initial camera orientation." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ProgressBar x:Name="LayoutProgressBar"
                                 Width="180"
                                 Height="12"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="#4FC3F7"
                                 Background="#0E1117"
                                 BorderBrush="#2E3644" />
                    <TextBlock x:Name="ProgressText"
                               Width="190"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="#9FB0C6"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CloseButton"
                            Padding="14,4"
                            Click="Close_Button_Click"
                            Content="Close (Esc)"
                            ToolTip="Close the visualizer. Esc also closes it." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#111827" />
                        <GradientStop Offset="1" Color="#05070B" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Viewport3D x:Name="GraphViewport" ClipToBounds="True" />

                <Border x:Name="ProgressOverlay"
                        Background="#B30A0D13"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#E6EDF7"
                                   Text="Building the 3D layout..." />
                        <TextBlock x:Name="OverlayDetailText"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#9FB0C6"
                                   Text="This can take a few seconds for large graphs." />
                    </StackPanel>
                </Border>

                <Border x:Name="EmptyStateOverlay"
                        Background="#CC0A0D13"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#E6EDF7"
                                   Text="No nodes to display." />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#9FB0C6"
                                   Text="Launch Core and add or load knowledge first." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Padding="14"
                    Background="#121722"
                    BorderBrush="#2E3644"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#8AB4F8"
                                   Text="GRAPH" />
                        <TextBlock x:Name="SummaryNodesText"
                                   Margin="0,0,0,4"
                                   Foreground="#D7E2F0"
                                   Text="Nodes: 0" />
                        <TextBlock x:Name="SummaryLinksText"
                                   Margin="0,0,0,4"
                                   Foreground="#D7E2F0"
                                   Text="Links: 0" />
                        <TextBlock x:Name="SummaryClassesText"
                                   Margin="0,0,0,4"
                                   Foreground="#D7E2F0"
                                   Text="Node classes: 0" />
                        <TextBlock x:Name="SummaryTypesText"
                                   Margin="0,0,0,4"
                                   Foreground="#D7E2F0"
                                   Text="Link types: 0" />

                        <TextBlock Margin="0,14,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#8AB4F8"
                                   Text="LAYOUT" />
                        <TextBlock x:Name="LayoutTimeText"
                                   Margin="0,0,0,4"
                                   Foreground="#D7E2F0"
                                   Text="Layout: (not run)" />
                        <TextBlock x:Name="SummaryRadiusText"
                                   Foreground="#D7E2F0"
                                   Text="Radius: (not run)" />

                        <TextBlock Margin="0,14,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#8AB4F8"
                                   Text="WARNINGS" />
                        <TextBlock x:Name="WarningsText"
                                   TextWrapping="Wrap"
                                   Foreground="#F0B86E"
                                   Text="None." />

                        <TextBlock Margin="0,14,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#8AB4F8"
                                   Text="CONTROLS" />
                        <TextBlock Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Foreground="#9FB0C6"
                                   Text="Esc closes the visualizer. The Close (Esc) button does the same." />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#9FB0C6"
                                   Text="Fly navigation, labels, and color controls arrive in later phases." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,6"
                Background="#171C27"
                BorderBrush="#2E3644"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           Foreground="#6F7F94"
                           Text="Esc closes" />
                <TextBlock x:Name="StatusText"
                           Foreground="#C7D3E2"
                           Text="Ready."
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
