<Window x:Class="OPEN_LRD.NlpWorkbenchWindow"
        x:Name="WorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPEN_LRD"
        mc:Ignorable="d"
        Title="NLP Workbench"
        Height="760"
        Width="1100"
        MinHeight="620"
        MinWidth="900">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="210" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Session Status" Padding="6">
            <WrapPanel>
                <TextBlock x:Name="CoreStatusText"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Core: Not initialized" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Conversation:" />
                <TextBlock x:Name="ConversationIDText"
                           Width="280"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Text="(none)" />
                <Button x:Name="CopyConversationButton"
                        Margin="0,0,16,0"
                        Padding="8,2"
                        Click="CopyConversation_Button_Click"
                        Content="Copy" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Pipeline:" />
                <TextBlock x:Name="PipelineIDText"
                           Width="280"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Text="(none)" />
                <TextBlock x:Name="TurnIndexText"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Text="Turns: 0" />
                <TextBlock x:Name="GraphCountsText"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Text="Nodes: 0   Directed Links: 0" />
                <Button x:Name="RefreshButton"
                        Padding="8,2"
                        Click="Refresh_Button_Click"
                        Content="Refresh" />
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Conversations" Padding="6" Margin="0,6,0,0">
            <WrapPanel>
                <Button x:Name="NewConversationButton"
                        Margin="0,0,8,0"
                        Padding="8,2"
                        Click="NewConversation_Button_Click"
                        Content="New Conversation" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Attach ID:" />
                <TextBox x:Name="AttachConversationBox"
                         Width="300"
                         Margin="0,0,6,0"
                         VerticalContentAlignment="Center" />
                <Button x:Name="AttachConversationButton"
                        Margin="0,0,16,0"
                        Padding="8,2"
                        Click="AttachConversation_Button_Click"
                        Content="Attach" />
                <Button x:Name="ResetConversationButton"
                        Margin="0,0,8,0"
                        Padding="8,2"
                        Click="ResetConversation_Button_Click"
                        Content="Reset Conversation" />
                <Button x:Name="RemoveConversationButton"
                        Margin="0,0,8,0"
                        Padding="8,2"
                        Click="RemoveConversation_Button_Click"
                        Content="Remove Conversation" />
                <Button x:Name="ClearConversationsButton"
                        Padding="8,2"
                        Click="ClearConversations_Button_Click"
                        Content="Clear All Conversations" />
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Operations" Padding="6" Margin="0,6,0,0">
            <TabControl Margin="0,2,0,0">
                <TabItem Header="Ingest">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Statement" />
                        <TextBox x:Name="IngestInput"
                                 Grid.Row="1"
                                 Margin="0,4,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Source Node ID (optional):" />
                            <TextBox x:Name="IngestSourceBox"
                                     Width="260"
                                     Margin="0,0,16,0"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Topic Node ID (optional):" />
                            <TextBox x:Name="IngestTopicBox"
                                     Width="260"
                                     Margin="0,0,16,0"
                                     VerticalContentAlignment="Center" />
                            <Button x:Name="IngestButton"
                                    Padding="10,3"
                                    Click="Ingest_Button_Click"
                                    Content="Ingest" />
                        </WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Ask">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Question" />
                        <TextBox x:Name="AskInput"
                                 Grid.Row="1"
                                 Margin="0,4,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                            <Button x:Name="AskButton"
                                    Padding="10,3"
                                    Click="Ask_Button_Click"
                                    Content="Ask" />
                        </WrapPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Result Summary" Padding="6" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <TextBlock x:Name="OperationStatusText"
                               Margin="0,0,16,0"
                               FontWeight="SemiBold"
                               Text="No operation yet." />
                    <TextBlock x:Name="ConfidenceText"
                               Margin="0,0,16,0"
                               Text="Confidence: (n/a)" />
                    <TextBlock x:Name="EvidenceFlagsText"
                               Text="Temporary evidence: False   Session provenance: False" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Margin="0,4,0,2" Text="Answer / Summary" />
                <TextBox x:Name="AnswerText"
                         Grid.Row="2"
                         Height="54"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Row="3" Margin="0,4,0,2" Text="Short Answer" />
                <TextBox x:Name="ShortAnswerText"
                         Grid.Row="4"
                         Height="24"
                         IsReadOnly="True" />
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="4" Margin="0,6,0,0">
            <TabItem Header="Diagnostics">
                <ListBox x:Name="DiagnosticsList"
                         Margin="4"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Evidence / Candidates">
                <DataGrid x:Name="CandidatesGrid"
                          Margin="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="140" />
                        <DataGridTextColumn Header="Node Type" Binding="{Binding NodeType}" Width="100" />
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="70" />
                        <DataGridTextColumn Header="Depth" Binding="{Binding Depth}" Width="60" />
                        <DataGridTextColumn Header="Relation Link Type" Binding="{Binding RelationLinkType}" Width="120" />
                        <DataGridTextColumn Header="Link Class" Binding="{Binding LinkClass}" Width="90" />
                        <DataGridTextColumn Header="Temporary" Binding="{Binding Temporary}" Width="80" />
                        <DataGridTextColumn Header="Path Node IDs" Binding="{Binding PathNodeIDs}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Frames and Chains">
                <DataGrid x:Name="FramesGrid"
                          Margin="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Session Mentions">
                <DataGrid x:Name="MentionsGrid"
                          Margin="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="70" />
                        <DataGridTextColumn Header="Turn" Binding="{Binding Turn}" Width="60" />
                        <DataGridTextColumn Header="Node ID" Binding="{Binding NodeID}" Width="240" />
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="130" />
                        <DataGridTextColumn Header="Surface" Binding="{Binding Surface}" Width="130" />
                        <DataGridTextColumn Header="Node Type" Binding="{Binding NodeType}" Width="100" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80" />
                        <DataGridTextColumn Header="From Answer" Binding="{Binding FromAnswer}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Session Provenance">
                <DataGrid x:Name="ProvenanceGrid"
                          Margin="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="50" />
                        <DataGridTextColumn Header="Turn" Binding="{Binding Turn}" Width="50" />
                        <DataGridTextColumn Header="Sentence" Binding="{Binding Sentence}" Width="70" />
                        <DataGridTextColumn Header="Source Text" Binding="{Binding SourceText}" Width="180" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Relation" Binding="{Binding Relation}" Width="100" />
                        <DataGridTextColumn Header="Link Class" Binding="{Binding LinkClass}" Width="90" />
                        <DataGridTextColumn Header="Subject Node ID" Binding="{Binding SubjectNodeID}" Width="220" />
                        <DataGridTextColumn Header="Object Node ID" Binding="{Binding ObjectNodeID}" Width="220" />
                        <DataGridTextColumn Header="Qualifier Node ID" Binding="{Binding QualifierNodeID}" Width="220" />
                        <DataGridTextColumn Header="Trust Source" Binding="{Binding TrustSourceNodeID}" Width="220" />
                        <DataGridTextColumn Header="Topic" Binding="{Binding TopicNodeID}" Width="220" />
                        <DataGridTextColumn Header="Temporary Nodes" Binding="{Binding TemporaryNodeCount}" Width="100" />
                        <DataGridTextColumn Header="Graph Mutated" Binding="{Binding GraphMutated}" Width="100" />
                        <DataGridTextColumn Header="Usable For Answer" Binding="{Binding UsableForAnswer}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Session Focus">
                <DataGrid x:Name="FocusGrid"
                          Margin="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="220" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Module Limits">
                <TextBlock Margin="12"
                           TextWrapping="Wrap"
                           Text="Module 3 does not provide durable persistence, Import, Export, or Visualizer support. The separate Tools window remains the placeholder for those planned tools." />
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="5" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="WorkbenchStatusBar" Text="Ready." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
