<Window x:Class="OPEN_LRD.Tools"
        x:Name="ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPEN_LRD"
        mc:Ignorable="d"
        Title="Tools"
        Height="800"
        Width="860"
        MinHeight="700"
        MinWidth="760">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <TabControl x:Name="ToolsTabControl" Grid.Row="0">
            <TabItem Header="Logs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Export" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <Button x:Name="ExportLogsButton"
                                            Padding="12,4"
                                            Click="ExportLogs_Button_Click"
                                            Content="Export Logs" />
                                    <CheckBox x:Name="IncludeTransientCheckBox"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="True"
                                              Content="Include Transient Chains" />
                                </WrapPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="0,8,0,0"
                                           Text="The core log stores graph and conversation data. Transient chains use a separate companion log." />
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Last export:" />
                                    <TextBlock x:Name="LastExportPathText"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="(none)" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Import" Padding="8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Mode:" />
                                    <RadioButton x:Name="MergeModeRadio"
                                                 Margin="0,0,16,0"
                                                 VerticalAlignment="Center"
                                                 GroupName="ImportModeGroup"
                                                 IsChecked="True"
                                                 Content="Merge" />
                                    <RadioButton x:Name="ReplaceModeRadio"
                                                 VerticalAlignment="Center"
                                                 GroupName="ImportModeGroup"
                                                 Content="Replace" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button x:Name="ImportCoreLogButton"
                                            Padding="12,4"
                                            Click="ImportCoreLog_Button_Click"
                                            Content="Import Core Log" />
                                    <Button x:Name="ImportTransientLogButton"
                                            Margin="10,0,0,0"
                                            Padding="12,4"
                                            Click="ImportTransientLog_Button_Click"
                                            Content="Import Transient Log" />
                                </WrapPanel>
                                <TextBlock Grid.Row="2"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="Merge keeps existing data when IDs conflict. Replace swaps the selected state after validation. Pipeline attachments are never imported or exported." />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ingestion">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Topic" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Text="Selection:" />
                                <ComboBox x:Name="TopicModeComboBox"
                                          Grid.Row="0" Grid.Column="1"
                                          SelectionChanged="TopicModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="base/general/none" Tag="Base" />
                                    <ComboBoxItem Content="GUID" Tag="Guid" />
                                    <ComboBoxItem Content="Sense" Tag="Sense" />
                                    <ComboBoxItem Content="Node Label" Tag="Label" />
                                    <ComboBoxItem Content="Node Type" Tag="NodeType" />
                                    <ComboBoxItem Content="Alias" Tag="Alias" />
                                    <ComboBoxItem Content="Category" Tag="Category" />
                                    <ComboBoxItem Content="Field/Discipline" Tag="Field" />
                                    <ComboBoxItem Content="Taxon" Tag="Taxon" />
                                    <ComboBoxItem Content="Reality" Tag="Reality" />
                                    <ComboBoxItem Content="Current Topic" Tag="CurrentTopic" />
                                    <ComboBoxItem Content="Source" Tag="Source" />
                                </ComboBox>
                                <TextBlock x:Name="TopicValueLabel"
                                           Grid.Row="0" Grid.Column="2"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="Value:" />
                                <TextBox x:Name="TextImportTopicBox"
                                         Grid.Row="0" Grid.Column="3"
                                         VerticalAlignment="Center" />

                                <TextBlock x:Name="TopicNodeTypeLabel"
                                           Grid.Row="1" Grid.Column="0"
                                           Margin="0,8,8,0"
                                           VerticalAlignment="Center"
                                           Text="Type:" />
                                <ComboBox x:Name="TopicNodeTypeComboBox"
                                          Grid.Row="1" Grid.Column="1"
                                          Margin="0,8,0,0"
                                          SelectionChanged="TopicNodeTypeComboBox_SelectionChanged"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="TopicNodePickerLabel"
                                           Grid.Row="1" Grid.Column="2"
                                           Margin="12,8,8,0"
                                           VerticalAlignment="Center"
                                           Text="Topic node:" />
                                <ComboBox x:Name="TopicNodePickerComboBox"
                                          Grid.Row="1" Grid.Column="3"
                                          Margin="0,8,0,0"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="ID"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="TopicSelectionStatusText"
                                           Grid.Row="2"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="4"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="No topic override; use base/general/none." />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Direct Text Ingestion" Padding="8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="DirectTextInput"
                                         Grid.Row="0"
                                         MinHeight="100"
                                         MaxLength="1000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Up to 1,000 characters. Multi-sentence text is ingested one sentence at a time." />
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <CheckBox x:Name="DirectTextDryRunCheckBox"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              Content="Dry run" />
                                    <Button x:Name="DirectTextIngestButton"
                                            Padding="12,4"
                                            Click="DirectTextIngest_Button_Click"
                                            Content="Ingest Text" />
                                    <Button x:Name="DirectTextClearButton"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            Click="DirectTextClear_Button_Click"
                                            Content="Clear" />
                                    <ProgressBar x:Name="DirectTextProgressBar"
                                                 Width="180"
                                                 Height="16"
                                                 Margin="12,0,0,0"
                                                 Minimum="0"
                                                 Maximum="100" />
                                </WrapPanel>
                                <TextBlock x:Name="DirectTextStatusText"
                                           Grid.Row="2"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Ready." />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Text File Import" Padding="8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="0,0,6,0"
                                               VerticalAlignment="Center" Text="File:" />
                                    <TextBox x:Name="TextImportPathBox"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsReadOnly="True" />
                                    <Button x:Name="TextImportBrowseButton"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            Click="TextImportBrowse_Button_Click"
                                            Content="Browse..." />
                                </Grid>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Source ID:" />
                                    <TextBox x:Name="TextImportSourceBox" Width="260" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <CheckBox x:Name="TextImportDryRunCheckBox"
                                              VerticalAlignment="Center"
                                              Content="Dry run" />
                                    <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="Max file MiB:" />
                                    <TextBox x:Name="TextImportMaxMegabytesBox" Width="70" Text="500" />
                                    <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="Max chunks:" />
                                    <TextBox x:Name="TextImportMaxChunksBox" Width="80" Text="10000" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                    <Button x:Name="TextImportButton"
                                            Padding="12,4"
                                            Click="TextImport_Button_Click"
                                            Content="Import Text File" />
                                    <Button x:Name="TextImportCancelButton"
                                            Margin="10,0,0,0"
                                            Padding="12,4"
                                            IsEnabled="False"
                                            Click="TextImportCancel_Button_Click"
                                            Content="Cancel" />
                                    <ProgressBar x:Name="TextImportProgressBar"
                                                 Width="180"
                                                 Height="16"
                                                 Margin="10,0,0,0"
                                                 Minimum="0"
                                                 Maximum="100" />
                                </WrapPanel>
                                <TextBlock x:Name="TextImportStatusText"
                                           Grid.Row="4"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Ready. 0 chunks." />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ontology">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Upper Ontology and GCIDE" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <Button x:Name="SeedOntologyButton"
                                            Padding="12,4"
                                            Click="SeedOntology_Button_Click"
                                            Content="Seed Upper Ontology" />
                                    <Button x:Name="LoadGcideButton"
                                            Margin="10,0,0,0"
                                            Padding="12,4"
                                            Click="LoadGcide_Button_Click"
                                            Content="Load GCIDE Lexicon..." />
                                    <Button x:Name="ExportOntologyButton"
                                            Margin="10,0,0,0"
                                            Padding="12,4"
                                            Click="ExportOntology_Button_Click"
                                            Content="Export Ontology Log" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Subset:" />
                                    <ComboBox x:Name="CorpusSubsetCombo"
                                              Width="150"
                                              Margin="0,0,12,0"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Semantic subset" />
                                        <ComboBoxItem Content="Whole corpus" />
                                        <ComboBoxItem Content="Single letter" />
                                    </ComboBox>
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Letter:" />
                                    <TextBox x:Name="CorpusLetterBox"
                                             Width="32"
                                             MaxLength="1"
                                             Margin="0,0,12,0" />
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Max entries (0 = all):" />
                                    <TextBox x:Name="CorpusMaxEntriesBox" Width="70" Text="2000" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <ProgressBar x:Name="OntologyProgressBar"
                                                 Width="220"
                                                 Height="16"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Margin="0,0,10,0" />
                                    <Button x:Name="CancelOntologyButton"
                                            Padding="12,4"
                                            IsEnabled="False"
                                            Click="CancelOntology_Button_Click"
                                            Content="Cancel" />
                                    <TextBlock x:Name="OntologyStatusText"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="No ontology load running." />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Graph Maintenance" Padding="8" Margin="8">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="MaintenanceMergeNodesCheckBox"
                                          Margin="0,0,12,8"
                                          IsChecked="True"
                                          Content="Merge overlapping nodes" />
                                <CheckBox x:Name="MaintenanceMetadataCheckBox"
                                          Margin="0,0,12,8"
                                          IsChecked="True"
                                          Content="Materialize node metadata" />
                                <CheckBox x:Name="MaintenanceCompositionCheckBox"
                                          Margin="0,0,12,8"
                                          IsChecked="True"
                                          Content="Compose relations" />
                                <CheckBox x:Name="MaintenancePatternCheckBox"
                                          Margin="0,0,12,8"
                                          IsChecked="True"
                                          Content="Abstract frequent patterns" />
                                <CheckBox x:Name="MaintenanceElevationCheckBox"
                                          Margin="0,0,12,8"
                                          IsChecked="True"
                                          Content="Create relation concepts" />
                                <CheckBox x:Name="MaintenancePruningCheckBox"
                                          Margin="0,0,12,8"
                                          IsChecked="True"
                                          Content="Prune superseded links" />
                            </WrapPanel>
                            <Button x:Name="RunMaintenanceButton"
                                    HorizontalAlignment="Left"
                                    Padding="12,4"
                                    Click="RunMaintenance_Button_Click"
                                    Content="Run Maintenance" />
                            <TextBlock x:Name="MaintenanceStatusText"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="Reasoning passes are opt-in; run maintenance to apply selected passes." />
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Data Files">
                <Grid />
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="1" Header="Status" Padding="8" Margin="0,8,0,0">
            <TextBox x:Name="StatusBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Text="Ready." />
        </GroupBox>
    </Grid>
</Window>
