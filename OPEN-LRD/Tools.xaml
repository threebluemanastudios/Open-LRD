<Window x:Class="OPEN_LRD.Tools"
        x:Name="ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPEN_LRD"
        mc:Ignorable="d"
        Title="Tools"
        Height="800"
        Width="860"
        MinHeight="700"
        MinWidth="760">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Export" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <Button x:Name="ExportLogsButton"
                            Padding="12,4"
                            Click="ExportLogs_Button_Click"
                            Content="Export Logs" />
                    <CheckBox x:Name="IncludeTransientCheckBox"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="True"
                              Content="Include Transient Chains" />
                </WrapPanel>
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Text="The core log stores graph and conversation data. Transient chains use a separate companion log." />
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Last export:" />
                    <TextBlock x:Name="LastExportPathText"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="(none)" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Import" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Mode:" />
                    <RadioButton x:Name="MergeModeRadio"
                                 Margin="0,0,16,0"
                                 VerticalAlignment="Center"
                                 GroupName="ImportModeGroup"
                                 IsChecked="True"
                                 Content="Merge" />
                    <RadioButton x:Name="ReplaceModeRadio"
                                 VerticalAlignment="Center"
                                 GroupName="ImportModeGroup"
                                 Content="Replace" />
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button x:Name="ImportCoreLogButton"
                            Padding="12,4"
                            Click="ImportCoreLog_Button_Click"
                            Content="Import Core Log" />
                    <Button x:Name="ImportTransientLogButton"
                            Margin="10,0,0,0"
                            Padding="12,4"
                            Click="ImportTransientLog_Button_Click"
                            Content="Import Transient Log" />
                </WrapPanel>
                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="Merge keeps existing data when IDs conflict. Replace swaps the selected state after validation. Pipeline attachments are never imported or exported." />

                <Separator Grid.Row="3" Margin="0,10,0,6" />

                <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Text File Import" />

                <Grid Grid.Row="5" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Text="File:" />
                    <TextBox x:Name="TextImportPathBox"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             IsReadOnly="True" />
                    <Button x:Name="TextImportBrowseButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="12,4"
                            Click="TextImportBrowse_Button_Click"
                            Content="Browse..." />
                </Grid>

                <WrapPanel Grid.Row="6" Margin="0,6,0,0">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Source ID:" />
                    <TextBox x:Name="TextImportSourceBox"
                             Width="250"
                             Margin="0,0,14,0" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Topic ID:" />
                    <TextBox x:Name="TextImportTopicBox"
                             Width="250" />
                </WrapPanel>

                <WrapPanel Grid.Row="7" Margin="0,6,0,0">
                    <CheckBox x:Name="TextImportDryRunCheckBox"
                              VerticalAlignment="Center"
                              Content="Dry run" />
                    <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="Max file MB:" />
                    <TextBox x:Name="TextImportMaxMegabytesBox"
                             Width="60"
                             Text="50" />
                    <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="Max chunks:" />
                    <TextBox x:Name="TextImportMaxChunksBox"
                             Width="70"
                             Text="10000" />
                </WrapPanel>

                <WrapPanel Grid.Row="8" Margin="0,8,0,0">
                    <Button x:Name="TextImportButton"
                            Padding="12,4"
                            Click="TextImport_Button_Click"
                            Content="Import Text File" />
                    <Button x:Name="TextImportCancelButton"
                            Margin="10,0,0,0"
                            Padding="12,4"
                            IsEnabled="False"
                            Click="TextImportCancel_Button_Click"
                            Content="Cancel" />
                    <ProgressBar x:Name="TextImportProgressBar"
                                 Width="180"
                                 Height="16"
                                 Margin="10,0,0,0"
                                 Minimum="0"
                                 Maximum="100" />
                </WrapPanel>

                <TextBlock x:Name="TextImportStatusText"
                           Grid.Row="9"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="Ready. 0 chunks." />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Ontology" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <Button x:Name="SeedOntologyButton"
                            Padding="12,4"
                            Click="SeedOntology_Button_Click"
                            Content="Seed Upper Ontology" />
                    <Button x:Name="LoadGcideButton"
                            Margin="10,0,0,0"
                            Padding="12,4"
                            Click="LoadGcide_Button_Click"
                            Content="Load GCIDE Lexicon..." />
                    <Button x:Name="ExportOntologyButton"
                            Margin="10,0,0,0"
                            Padding="12,4"
                            Click="ExportOntology_Button_Click"
                            Content="Export Ontology Log" />
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Subset:" />
                    <ComboBox x:Name="CorpusSubsetCombo"
                              Width="150"
                              Margin="0,0,12,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Semantic subset" />
                        <ComboBoxItem Content="Whole corpus" />
                        <ComboBoxItem Content="Single letter" />
                    </ComboBox>
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Letter:" />
                    <TextBox x:Name="CorpusLetterBox"
                             Width="32"
                             MaxLength="1"
                             Margin="0,0,12,0" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Max entries (0 = all):" />
                    <TextBox x:Name="CorpusMaxEntriesBox"
                             Width="70"
                             Text="2000" />
                </WrapPanel>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <ProgressBar x:Name="OntologyProgressBar"
                                 Width="220"
                                 Height="16"
                                 Minimum="0"
                                 Maximum="100"
                                 Margin="0,0,10,0" />
                    <Button x:Name="CancelOntologyButton"
                            Padding="12,4"
                            IsEnabled="False"
                            Click="CancelOntology_Button_Click"
                            Content="Cancel" />
                    <TextBlock x:Name="OntologyStatusText"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="No ontology load running." />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Graph Maintenance" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <CheckBox x:Name="MaintenanceMergeNodesCheckBox"
                              Margin="0,0,12,0"
                              IsChecked="True"
                              Content="Merge overlapping nodes" />
                    <CheckBox x:Name="MaintenanceMetadataCheckBox"
                              Margin="0,0,12,0"
                              IsChecked="True"
                              Content="Materialize node metadata" />
                    <CheckBox x:Name="MaintenanceCompositionCheckBox"
                              Margin="0,0,12,0"
                              IsChecked="True"
                              Content="Compose relations" />
                    <CheckBox x:Name="MaintenancePatternCheckBox"
                              Margin="0,0,12,0"
                              IsChecked="True"
                              Content="Abstract frequent patterns" />
                    <CheckBox x:Name="MaintenanceElevationCheckBox"
                              Margin="0,0,12,0"
                              IsChecked="True"
                              Content="Create relation concepts" />
                    <CheckBox x:Name="MaintenancePruningCheckBox"
                              Margin="0,0,12,0"
                              IsChecked="True"
                              Content="Prune superseded links" />
                    <Button x:Name="RunMaintenanceButton"
                            Padding="12,4"
                            Click="RunMaintenance_Button_Click"
                            Content="Run Maintenance" />
                </WrapPanel>
                <TextBlock x:Name="MaintenanceStatusText"
                           Grid.Row="1"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="Reasoning passes are opt-in; run maintenance to apply selected passes." />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Status" Padding="8" Margin="0,8,0,0">
            <TextBox x:Name="StatusBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Text="Ready." />
        </GroupBox>
    </Grid>
</Window>
