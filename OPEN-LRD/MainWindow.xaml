<Window x:Class="OPEN_LRD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPEN_LRD"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="WelcomeBox"
                 HorizontalAlignment="Center" 
                 Height="31" 
                 TextAlignment="Center" 
                 FontSize="18" 
                 Background="BlanchedAlmond"
                 TextWrapping="Wrap" 
                 Foreground="Chocolate"
                 BorderBrush="Black"
                 BorderThickness="2"
                 Text="Welcome to OPEN-LRD, the Open-Source Large Relational Database Model" 
                 VerticalAlignment="Top" 
                 Width="624" RenderTransformOrigin="0.501,0.549" Margin="0,186,0,0"
                 />
        <Button x:Name="LaunchButton" 
                HorizontalAlignment="Center" 
                Height="59" 
                Margin="0,308,0,0" 
                VerticalAlignment="Top" 
                Width="118" 
                RenderTransformOrigin="0.451,-0.097" 
                Click="Launch_Button_Click" 
                Content="Launch Core"
                />
        <Button Content="Tools" 
                HorizontalAlignment="Left" 
                Height="59" 
                Margin="88,308,0,0" 
                VerticalAlignment="Top" 
                Width="103" 
                Click="Tools_Button_Click"
                />
        <Button x:Name="NlpWorkbenchButton"
                Content="NLP Workbench"
                HorizontalAlignment="Right"
                Height="59"
                Margin="0,308,88,0"
                VerticalAlignment="Top"
                Width="130"
                IsEnabled="False"
                ToolTip="Launch Core before opening the NLP Workbench."
                Click="NlpWorkbench_Button_Click"
                />

    </Grid>
</Window>
